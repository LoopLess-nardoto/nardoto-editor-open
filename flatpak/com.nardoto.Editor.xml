<?xml version="1.0" encoding="UTF-8"?>
<mime-info xmlns="http://www.freedesktop.org/standards/shared-mime-info">
  <mime-type type="application/x-nardoto-editor-project">
    <comment>Projeto do Nardoto Editor</comment>
    <glob pattern="*.drift"/>
    <magic priority="50">
      <match type="string" offset="0" value="DRIFTPRJ"/>
    </magic>
    <icon name="com.nardoto.Editor"/>
  </mime-type>
</mime-info>
